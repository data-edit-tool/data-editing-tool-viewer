{
  "name": "data-editing-tool-web",
  "private": true,
  "version": "0.0.1",
  "description": "Local labeling viewer for imported media datasets.",
  "author": "maumai",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --port 3000 --host 0.0.0.0",
    "dev:electron": "vite --mode development --port 3000 --host 127.0.0.1",
    "electron:dev": "concurrently -k \"npm run dev:electron\" \"wait-on http://127.0.0.1:3000 && VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "electron:preview": "npm run build-production && electron .",
    "build-development": "tsc && vite build --mode development",
    "build-production": "tsc && vite build --mode production",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "package:dir": "npm run build-production && electron-builder --dir",
    "package:mac": "npm run build-production && electron-builder --mac",
    "package:win": "npm run build-production && electron-builder --win nsis --x64",
    "package:win:ia32": "npm run build-production && electron-builder --win nsis --ia32",
    "package:win:all": "npm run build-production && electron-builder --win nsis --x64 --ia32",
    "package:win:portable": "npm run build-production && electron-builder --win portable --x64",
    "package:win:dir": "npm run build-production && electron-builder --win --dir --x64",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.maumai.data-editing-tool-viewer",
    "productName": "Labeling tool",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Labeling tool",
      "language": "1042",
      "uninstallDisplayName": "Labeling tool"
    }
  },
  "dependencies": {
    "axios": "^1.4.0",
    "classnames": "^2.3.2",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "file-saver": "^2.0.5",
    "history": "^5.3.0",
    "html-react-parser": "^4.0.0",
    "js-sha512": "^0.8.0",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "path": "^0.12.7",
    "qs": "^6.11.2",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.44.3",
    "react-resizable": "^3.0.5",
    "react-rnd": "^10.4.1",
    "react-router-dom": "^6.12.1",
    "react-toastify": "^10.0.6",
    "react-tooltip": "^5.28.0",
    "react-virtualized": "^9.22.6",
    "recoil": "^0.7.7",
    "styled-components": "^6.0.0-rc.3",
    "styled-system": "^5.1.5",
    "usehooks-ts": "^2.9.1",
    "uuid": "^11.0.2",
    "wavesurfer.js": "^7.1.5"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.1",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@types/react-resizable": "^3.0.4",
    "@types/styled-components": "^5.1.26",
    "@types/styled-system": "^5.1.16",
    "@types/wavesurfer.js": "^6.0.6",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "prettier": "^2.8.8",
    "typescript": "^5.0.2",
    "vite": "^4.3.9",
    "vite-plugin-svgr": "^3.2.0",
    "vite-tsconfig-paths": "^4.2.0",
    "wait-on": "^9.0.10"
  }
}
